# Backend
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./local_database.db
SCRAPER_HEADLESS=true
DAILY_TARGET_MIN=1000
DAILY_TARGET_MAX=2000

# --- Google via SerpAPI (optional — missing/invalid key = silent fallback, no error) ---
# SERPAPI_KEY=your_serpapi_key_here
# SERPAPI_PAGES=1
# SERPAPI_EXPAND_TARGET=50
# SERPAPI_EXPAND_PAGES=8
# SERPAPI_CACHE_ENABLED=true
# SERPAPI_CACHE_TTL_DAYS=0
# LISTING_SERPAPI_ONLY=false

USE_GOOGLE_BROWSER_LISTING=false
USE_DDG_HTTP_LISTING=true
LISTING_QUERY_GAP_SEC=3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002
